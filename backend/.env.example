# Copy this file to .env and fill in your own values.
# Never commit the actual .env file — it contains secrets!

# Generate a real one for production: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Automated M-Pesa Daraja billing is intentionally disabled until production
# credentials, callbacks, and reconciliation requirements are ready.
MPESA_DARAJA_ENABLED=False

# -------------------------------------------------------
# Production only — leave unset for local dev
# -------------------------------------------------------
# Postgres connection string from your host, e.g.
# postgres://user:password@host:5432/dbname — unset uses local sqlite.
DATABASE_URL=

# Comma-separated: your deployed frontend's origin(s), added on top of the
# localhost dev ports (which stay allowed everywhere). No trailing slash.
# e.g. https://www.nyakizudigital.me
EXTRA_CORS_ORIGINS=
EXTRA_CSRF_ORIGINS=

# Comma-separated IPs and/or CIDR ranges allowed to reach /admin/, e.g.
# "41.90.12.4,102.68.0.0/16" — a static office/VPN IP, not your home ISP's
# (that usually rotates). Leave unset to leave /admin/ open to everyone who
# has valid staff credentials, same as today.
ADMIN_ALLOWED_IPS=

# Cookie/HTTPS enforcement — default to secure automatically whenever
# DEBUG=False, only set these if you need to override that.
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True

# Media storage (avatars, product photos) — leave R2_BUCKET_NAME unset to
# keep using local disk (fine for dev; most free hosts wipe it on redeploy).
# From Cloudflare dashboard -> R2 -> create bucket -> "Manage API tokens":
#   R2_ENDPOINT_URL is https://<account_id>.r2.cloudflarestorage.com
#   R2_PUBLIC_URL is the bucket's public dev URL (or a custom domain you map to it)
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# -------------------------------------------------------
# Google OAuth2 — needed for "Continue with Google"
# -------------------------------------------------------
# 1. Go to https://console.cloud.google.com/
# 2. Create a project → APIs & Services → Credentials
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Authorised redirect URI: http://localhost:8000/accounts/google/login/callback/
#    In production, ADD a second one for your real domain:
#    https://your-backend-domain.com/accounts/google/login/callback/
# 5. Copy the Client ID and Secret below
#
# Then in the Django admin (after running the server):
#   Sites → change example.com to localhost:8000 (or your production domain)
#   Social applications → Add → Google → paste Client ID + Secret → choose the site
#
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -------------------------------------------------------
# Email — outbound (verification, orders, payments, alerts…)
# -------------------------------------------------------
FRONTEND_VERIFY_BASE_URL=http://localhost:3000

# LOCAL DEV: print emails to the console, send nothing.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# PRODUCTION, option A (recommended): Resend HTTPS API.
# Just set this — settings.py auto-switches EMAIL_BACKEND to Anymail's Resend
# backend. Get the key at https://resend.com → API Keys (Sending access).
RESEND_API_KEY=

# PRODUCTION, option B: real SMTP (e.g. a host that doesn't block port 587).
# Leave RESEND_API_KEY unset and fill these instead. For Resend SMTP:
#   EMAIL_HOST=smtp.resend.com  EMAIL_PORT=587  EMAIL_HOST_USER=resend
#   EMAIL_HOST_PASSWORD=<a Resend API key>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Sending domain — must be VERIFIED in Resend. nyakizudigital.me is verified;
# a dedicated subdomain (e.g. mail.nyakizudigital.me) was attempted but added
# with a typo in Resend and never verified — swap this once a correctly
# spelled subdomain is verified, to isolate sending reputation from root.
# All six purpose addresses below default to <name>@$EMAIL_SENDING_DOMAIN.
EMAIL_SENDING_DOMAIN=nyakizudigital.me

# Per-purpose From addresses — only set one to override its default
# ("Name <addr>" or a bare address both work).
# EMAIL_FROM_ACCOUNTS=Nyakizu Accounts <accounts@nyakizudigital.me>
# EMAIL_FROM_ORDERS=Nyakizu Orders <orders@nyakizudigital.me>
# EMAIL_FROM_PAYMENTS=Nyakizu Payments <payments@nyakizudigital.me>
# EMAIL_FROM_SELLERS=Nyakizu Sellers <sellers@nyakizudigital.me>
# EMAIL_FROM_ALERTS=Nyakizu Alerts <alerts@nyakizudigital.me>
# EMAIL_FROM_MARKETING=Nyakizu <hello@nyakizudigital.me>

# Where replies go (none of the sending addresses above have a real inbox).
# Needs a real mailbox or forwarder. Blank = no Reply-To header.
EMAIL_REPLY_TO=support@nyakizudigital.me

# Fallback sender — used when EMAIL_SENDERS has no entry for a category, and
# by any Django/allauth mail that bypasses nyakizu.emailing.sender(). Domain
# must be verified in Resend — nyakizudigital.me is.
DEFAULT_FROM_EMAIL=Nyakizu <noreply@nyakizudigital.me>

# Envelope sender for Django's own admin-error emails (mail_admins on a 500).
# Inert until ADMINS is also set — Sentry currently covers exception alerts.
SERVER_EMAIL=noreply@nyakizudigital.me

# -------------------------------------------------------
# Billing (docs/BILLING_SPEC.md) — per-order service fee
# -------------------------------------------------------
# The fee formula itself (rate, min/max, free-orders allowance) lives in the
# database (billing.models.FeeSchedule), not here — see the admin.
#
# Two independent switches, both False until go-live.
#
# CHARGING: while False, locking an order charges nothing, uses up no free
# orders, and moves no balance — safe to deploy and test without billing anyone.
# Switch to True at go-live; every seller's free orders then count from that moment.
BILLING_CHARGING_ENABLED=False
# ENFORCEMENT: while False, an unpaid balance never blocks anything (levels 3/4
# of the ladder below are off). Switch to True only once M-Pesa top-ups are live,
# otherwise a blocked seller has no way to pay their way out.
BILLING_ENFORCEMENT_ENABLED=False

# Enforcement ladder thresholds (KES owed / days in debt) — see
# billing.services.enforcement_level. Levels 0-2 are informational only.
BILLING_LOW_CREDIT_KES=100
BILLING_LEVEL3_OWED_KES=200
BILLING_LEVEL3_DAYS=7
BILLING_LEVEL4_OWED_KES=500
BILLING_LEVEL4_DAYS=14

# -------------------------------------------------------
# Safaricom Daraja — M-Pesa STK Push top-ups for the billing credit
# -------------------------------------------------------
# From your Daraja app (developer.safaricom.co.ke -> My Apps). Sandbox needs no
# approval at all: create an app, tick the M-Pesa Express box, and these two come
# from its details page. Set them ONLY in your own environment (this file is a
# template). Blank = top-ups are off.
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=

# 'sandbox' or 'production'. Sandbox uses Safaricom's shared test shortcode/passkey
# below (already filled in — they are public test values, not secrets, the same
# for every developer). Switch to 'production' only with your own approved
# Paybill/Till and its own passkey from Safaricom, in DARAJA_SHORTCODE/DARAJA_PASSKEY.
DARAJA_ENV=sandbox
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# CustomerPayBillOnline for a Paybill, CustomerBuyGoodsOnline for a Till.
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline

# Must be a public HTTPS URL Safaricom can reach — never localhost. Leave blank
# for local development; the seller's own status poll still confirms and credits
# every top-up without it (see billing/payments.py).
DARAJA_CALLBACK_URL=

# Optional: only accept the callback from these source IPs (comma separated).
# Daraja's callback has no signature to check, so this is a soft extra layer,
# not the thing keeping it safe — see billing/views.py. Blank = don't check.
DARAJA_WEBHOOK_IPS=

# Top-up limits in whole KES.
BILLING_MIN_TOPUP_KES=50
BILLING_MAX_TOPUP_KES=20000
