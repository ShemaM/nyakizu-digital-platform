# Copy this file to .env and fill in your own values.
# Never commit the actual .env file — it contains secrets!

# Generate a real one for production: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# -------------------------------------------------------
# Production only — leave unset for local dev
# -------------------------------------------------------
# Postgres connection string from your host, e.g.
# postgres://user:password@host:5432/dbname — unset uses local sqlite.
DATABASE_URL=

# Comma-separated: your deployed frontend's origin(s), added on top of the
# localhost dev ports (which stay allowed everywhere). No trailing slash.
# e.g. https://nyakizu.vercel.app
EXTRA_CORS_ORIGINS=
EXTRA_CSRF_ORIGINS=

# Cookie/HTTPS enforcement — default to secure automatically whenever
# DEBUG=False, only set these if you need to override that.
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True

# Media storage (avatars, product photos) — leave R2_BUCKET_NAME unset to
# keep using local disk (fine for dev; most free hosts wipe it on redeploy).
# From Cloudflare dashboard -> R2 -> create bucket -> "Manage API tokens":
#   R2_ENDPOINT_URL is https://<account_id>.r2.cloudflarestorage.com
#   R2_PUBLIC_URL is the bucket's public dev URL (or a custom domain you map to it)
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# -------------------------------------------------------
# Google OAuth2 — needed for "Continue with Google"
# -------------------------------------------------------
# 1. Go to https://console.cloud.google.com/
# 2. Create a project → APIs & Services → Credentials
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Authorised redirect URI: http://localhost:8000/accounts/google/login/callback/
#    In production, ADD a second one for your real domain:
#    https://your-backend-domain.com/accounts/google/login/callback/
# 5. Copy the Client ID and Secret below
#
# Then in the Django admin (after running the server):
#   Sites → change example.com to localhost:8000 (or your production domain)
#   Social applications → Add → Google → paste Client ID + Secret → choose the site
#
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -------------------------------------------------------
# Email verification
# -------------------------------------------------------
FRONTEND_VERIFY_BASE_URL=http://localhost:3000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@nyakizu.local
